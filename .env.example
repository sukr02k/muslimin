# ============================================================
# Muslimin — Environment Variables
# Flutter memakai --dart-define, bukan file .env native.
# Contoh injeksi:
#   flutter run --dart-define=APP_ENV=development --dart-define=APP_NAME="Muslim"
# Simpan nilai default aman; JANGAN commit nilai rahasia.
# App ini full offline => tidak ada API key server.
# ============================================================

# --- Aplikasi ---
APP_ENV=development          # development | staging | production
APP_NAME=Muslimin
APP_VERSION=1.0.0
APP_BUILD=1

# --- Lokasi default (fallback saat GPS ditolak) ---
DEFAULT_LOCATION_LAT=-6.2088
DEFAULT_LOCATION_LNG=106.8456
DEFAULT_LOCATION_CITY=Jakarta
DEFAULT_LOCATION_COUNTRY_CODE=ID

# --- Kalkulasi sholat (metode & mazhab default) ---
PRAYER_CALC_METHOD=Kemenag   # referensi metode kalkulasi (lihat paket adhan)
PRAYER_MADHAB=Shafi          # Shafi | Hanafi (mempengaruhi waktu Ashar)
PRAYER_ADJUSTMENT_MINUTES=0  # offset menit global (opsional)

# --- Kiblat ---
QIBLA_TARGET_LAT=21.4225     # koordinat Ka'bah (tetap)
QIBLA_TARGET_LNG=39.8262

# --- Adhan Reminder (notifikasi lokal) ---
REMINDER_PRE_ADHAN_MINUTES=5  # offset default menit sebelum azan
REMINDER_ENABLED_BY_DEFAULT=false

# --- Tidak dibutuhkan untuk MVP (full offline) ---
# Tidak ada API base URL, DB server, atau key pihak ketiga.